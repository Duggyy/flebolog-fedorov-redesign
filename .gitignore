node_modules
dist
dist-ssr
# ⚠️ Слэш в начале — только корень проекта. Без него правило `dist-clinicbase`
# совпадает с любым сегментом пути и наглухо игнорирует ещё и
# clinicbase-server-package/dist-clinicbase — тот самый пакет выкладки, который
# в репозитории нужен целиком. После пересборки новые хешированные ассеты туда
# не попадали (старые оставались отслеживаемыми, потому что .gitignore не
# разотслеживает уже добавленное), и в git ложился index.html со ссылками на
# файлы, которых в репозитории нет.
/dist-dafedorov
/dist-clinicbase
*.local

# Временные конфиги Vite (создаются при сборке)
vite.*.timestamp-*.mjs

# Медиа сайта: 392 МБ видео + 131 МБ фото. Хранится локально, в git не нужно.
# Уже отслеживаемые файлы внутри public/images/ это не затрагивает.
public/videos/
public/images/

# Исходники сториз от врача (24 вертикальных .mov, 3.9 ГБ). Это материал для
# монтажа, а не часть сайта: в репозиторий не попадает. Один клип — 830 МБ,
# при коммите он упёрся бы в лимит GitHub в 100 МБ на файл.
Сторисы АртВе/

# Сканы публикаций врача в высоком разрешении (7 файлов, 23.5 МБ) + дубликат
# картинки метода. Сайт их не использует — он берёт уменьшенные копии из
# public/images/, поэтому в репозитории им не место. Файлы остаются на диске
# как исходники для будущих веб-версий; в истории git они тоже сохранены.
# Слэш в начале — только корень проекта, чтобы не задеть одноимённые картинки
# в public/images/.
/IQ Флебология *.jpg
/Руководство по флебологии *.jpg
/method-microsklerotherapy.jpg

# Локальные данные рабочего окружения (память проекта, служебные файлы)
.workbuddy-ai/

# Архив для выкладки ClinicBase на reg.ru. Собирается в момент выкладки из
# dist-clinicbase (`zip` с содержимым папки, а не с самой папкой) — в
# репозитории не нужен: производный артефакт на 572 КБ, воспроизводится
# одной командой. Инструкция по загрузке — clinicbase-server-package/docs/.
clinicbase-server-package/clinicbase-upload.zip

# Архив для выкладки САЙТА на reg.ru: только те файлы, которых нет на боевом
# (сборка считается по content_type, см. SKILL.md «Что именно надо выложить»).
# Тоже производный артефакт — собирается из dist-dafedorov одной командой.
dafedorov-upload.zip

